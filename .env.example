# Supabase — pour le PIPELINE (main_pipeline.py), utilise la clé "service_role"
# (Project Settings > API > service_role), PAS la clé "anon". La clé
# service_role contourne les policies RLS et permet l'écriture (upsert).
# ⚠️ Elle est secrète : ne jamais la mettre dans le site web (web/config.js).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# INSEE - OPTIONNEL : non utilisée par le pipeline principal actuellement.
INSEE_API_KEY=

# Geod'Air / Atmo France officiel - optionnel (portail : https://www.geodair.fr).
ATMO_API_KEY=

# OpenAQ v3 - OBLIGATOIRE pour le fallback qualité de l'air (src/extract/atmo.py).
# Clé gratuite : https://explore.openaq.org/register
OPENAQ_API_KEY=
